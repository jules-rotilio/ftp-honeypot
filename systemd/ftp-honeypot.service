[Unit]
Description=FTP honeypot (bait listener on TCP 21)
Documentation=file:///opt/ftp-honeypot/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ftp-honeypot
Group=ftp-honeypot
ExecStart=/usr/bin/python3 -I /opt/ftp-honeypot/honeypot.py

Environment=HONEYPOT_PORT=21
Environment=HONEYPOT_LOG=/var/log/ftp-honeypot/ftp-honeypot.log
#Environment="HONEYPOT_BANNER=220 ProFTPD 1.3.8 Server (Debian) ready."
#Environment=HONEYPOT_MAX_CONN=100
#Environment=HONEYPOT_MAX_LOG_MB=200

LogsDirectory=ftp-honeypot
LogsDirectoryMode=0750

# The only privilege it gets: binding a port below 1024.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Sandboxing
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0027

MemoryMax=128M
TasksMax=32

Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
