[Unit]
Description=Refresh the DB-IP GeoIP database used by ftp-honeypot-bans
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/ftp-honeypot-geoip-update

# Runs as a throwaway unprivileged user created for each run. Its only
# writable place is the state directory (/var/lib/ftp-honeypot).
DynamicUser=yes
StateDirectory=ftp-honeypot
StateDirectoryMode=0755
UMask=0022

NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
MemoryMax=1G
TimeoutStartSec=15min
