#!/usr/bin/env bash
# ftp-honeypot-bans - view and remove IPs banned by the ftp-honeypot fail2ban jail
#
#   sudo ftp-honeypot-bans                 interactive menu
#   sudo ftp-honeypot-bans list            print the banned IPs and exit
#   sudo ftp-honeypot-bans show <IP>       what this IP did (honeypot log)
#   sudo ftp-honeypot-bans unban <IP>...   unban one or more IPs
#   sudo ftp-honeypot-bans unban-all       unban everyone (asks first)

set -uo pipefail

JAIL=ftp-honeypot
LOG=/var/log/ftp-honeypot/ftp-honeypot.log

if [[ -t 1 ]]; then
    B=$'\033[1m'; DIM=$'\033[2m'; RED=$'\033[31m'; GRN=$'\033[32m'; YEL=$'\033[33m'; CYN=$'\033[36m'; R=$'\033[0m'
else
    B=; DIM=; RED=; GRN=; YEL=; CYN=; R=
fi

die() { echo "${RED}error:${R} $*" >&2; exit 1; }

[[ $EUID -eq 0 ]] || die "run me as root: sudo $0 $*"
command -v fail2ban-client >/dev/null || die "fail2ban-client not found"
fail2ban-client status "$JAIL" >/dev/null 2>&1 \
    || die "fail2ban jail '$JAIL' is not running (systemctl status fail2ban)"

# --- helpers ---------------------------------------------------------------

# "2629800" -> "30d 10h"
human() {
    local s=${1%.*} d h m
    (( s < 0 )) && s=0
    d=$(( s / 86400 )); h=$(( s % 86400 / 3600 )); m=$(( s % 3600 / 60 ))
    if   (( d > 0 )); then echo "${d}d ${h}h"
    elif (( h > 0 )); then echo "${h}h ${m}m"
    else                   echo "${m}m"
    fi
}

# Fills the arrays IPS SINCE UNTIL LEFT, sorted by ban end (fail2ban's order).
load_bans() {
    IPS=(); SINCE=(); UNTIL=(); LEFT=()
    local now line ip start dur end end_s
    now=$(date +%s)
    # each line: "<ip> \t<YYYY-mm-dd HH:MM:SS> + <seconds> = <YYYY-mm-dd HH:MM:SS>"
    while IFS= read -r line; do
        [[ $line =~ ^([^[:space:]]+)[[:space:]]+([0-9-]+\ [0-9:]+)\ \+\ (-?[0-9.]+)\ =\ ([0-9-]+\ [0-9:]+) ]] || continue
        ip=${BASH_REMATCH[1]}; start=${BASH_REMATCH[2]}; dur=${BASH_REMATCH[3]}; end=${BASH_REMATCH[4]}
        IPS+=("$ip"); SINCE+=("${start%:*}")
        if [[ ${dur%.*} -lt 0 ]]; then
            UNTIL+=("permanent"); LEFT+=("-")
        else
            end_s=$(date -d "$end" +%s 2>/dev/null || echo "$now")
            UNTIL+=("${end%:*}"); LEFT+=("$(human $(( end_s - now )))")
        fi
    done < <(fail2ban-client get "$JAIL" banip --with-time 2>/dev/null)
}

# Number of password attempts an IP made, from the honeypot log
attempts() { grep -Fc "\"event\": \"login\", \"src\": \"$1\"" "$LOG" 2>/dev/null || true; }

print_list() {
    load_bans
    echo
    if (( ${#IPS[@]} == 0 )); then
        echo "  ${GRN}No IP is currently banned.${R}"
        return
    fi
    printf "  ${B}%-4s %-39s %-16s %-16s %-9s %s${R}\n" "#" "IP" "banned since" "until" "left" "logins"
    local i
    for i in "${!IPS[@]}"; do
        printf "  %-4s %-39s %-16s %-16s %-9s %s\n" \
            "$((i+1))" "${IPS[i]}" "${SINCE[i]}" "${UNTIL[i]}" "${LEFT[i]}" "$(attempts "${IPS[i]}")"
    done
    echo "  ${DIM}${#IPS[@]} banned · times are server local time${R}"
}

show_ip() {
    local ip=$1
    echo
    echo "  ${B}$ip${R}"
    if [[ ! -r $LOG ]]; then echo "  (log $LOG not readable)"; return; fi
    local first last n
    n=$(grep -Fc "\"src\": \"$ip\"" "$LOG" 2>/dev/null || true)
    if [[ ${n:-0} -eq 0 ]]; then
        echo "  ${DIM}nothing in the current log (it may have been rotated)${R}"
        return
    fi
    first=$(grep -F -m1 "\"src\": \"$ip\"" "$LOG" | sed -E 's/^\{"ts": "([^"]+)".*/\1/')
    last=$(grep -F "\"src\": \"$ip\"" "$LOG" | tail -1 | sed -E 's/^\{"ts": "([^"]+)".*/\1/')
    echo "  connections: $(grep -Fc "\"event\": \"connect\", \"src\": \"$ip\"" "$LOG")   first seen: $first   last seen: $last (UTC)"
    if [[ $(attempts "$ip") -eq 0 ]]; then
        echo "  ${DIM}no password tried${R}"
    else
        echo "  ${CYN}last credentials tried:${R}"
    fi
    grep -F "\"event\": \"login\", \"src\": \"$ip\"" "$LOG" | tail -10 | python3 -c '
import sys, json
for l in sys.stdin:
    try: e = json.loads(l)
    except ValueError: continue
    print("    %s  user=%r  pass=%r" % (e.get("ts"), e.get("user"), e.get("password")))
' 2>/dev/null || true
    local cmds
    cmds=$(grep -F "\"event\": \"cmd\", \"src\": \"$ip\"" "$LOG" | tail -5)
    if [[ -n $cmds ]]; then
        echo "  ${CYN}last other commands:${R}"
        echo "$cmds" | python3 -c '
import sys, json
for l in sys.stdin:
    try: e = json.loads(l)
    except ValueError: continue
    print("    %s  %r" % (e.get("ts"), e.get("cmd")))
' 2>/dev/null || true
    fi
}

is_banned() { local x; for x in "${IPS[@]}"; do [[ $x == "$1" ]] && return 0; done; return 1; }

unban() {
    local ip
    for ip in "$@"; do
        if fail2ban-client set "$JAIL" unbanip "$ip" >/dev/null 2>&1; then
            echo "  ${GRN}unbanned${R} $ip"
        else
            echo "  ${YEL}not banned${R} $ip"
        fi
    done
}

unban_all() {
    load_bans
    (( ${#IPS[@]} > 0 )) || { echo "  nothing to unban"; return; }
    local ans
    read -r -p "  Unban all ${#IPS[@]} IPs? [y/N] " ans
    [[ $ans =~ ^[yY]$ ]] || { echo "  cancelled"; return; }
    unban "${IPS[@]}"
}

# "3", "1 4", "1,2", "2-5", or IPs -> list of IPs (uses the last loaded list)
resolve() {
    local tok a b i out=()
    for tok in ${*//,/ }; do
        if [[ $tok =~ ^([0-9]+)-([0-9]+)$ ]]; then
            for (( i=BASH_REMATCH[1]; i<=BASH_REMATCH[2]; i++ )); do
                (( i>=1 && i<=${#IPS[@]} )) && out+=("${IPS[i-1]}")
            done
        elif [[ $tok =~ ^[0-9]+$ ]] && (( tok >= 1 && tok <= ${#IPS[@]} )); then
            out+=("${IPS[tok-1]}")
        elif [[ $tok == *.* || $tok == *:* ]]; then
            out+=("$tok")
        else
            echo "  ${YEL}ignored:${R} $tok" >&2
        fi
    done
    printf '%s\n' "${out[@]}"
}

menu() {
    local choice arg ips
    print_list
    while true; do
        echo
        echo "  ${B}[l]${R}ist  ${B}[s]${R}how <#|IP>  ${B}[u]${R}nban <#|IP> (e.g. 1 3 5-7)  ${B}[a]${R}ll unban  ${B}[q]${R}uit"
        read -r -p "  > " choice arg || { echo; return; }
        case "$choice" in
            l|L|"")  print_list ;;
            s|S)     [[ -n $arg ]] || read -r -p "  which # or IP? " arg
                     mapfile -t ips < <(resolve "$arg")
                     for ip in "${ips[@]}"; do show_ip "$ip"; done ;;
            u|U)     [[ -n $arg ]] || read -r -p "  which # or IP? " arg
                     mapfile -t ips < <(resolve "$arg")
                     (( ${#ips[@]} )) && unban "${ips[@]}" && print_list ;;
            a|A)     unban_all; print_list ;;
            q|Q|quit|exit) return ;;
            *)       echo "  ${YEL}unknown choice${R}" ;;
        esac
    done
}

# --- main ------------------------------------------------------------------

case "${1:-}" in
    "")          menu ;;
    list)        print_list ;;
    show)        shift; (( $# )) || die "usage: $0 show <IP>"; for ip in "$@"; do show_ip "$ip"; done ;;
    unban)       shift; (( $# )) || die "usage: $0 unban <IP>..."; unban "$@" ;;
    unban-all)   unban_all ;;
    -h|--help)   sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//' ;;
    *)           die "unknown command '$1' (see --help)" ;;
esac
