#!/usr/bin/env bash
# ftp-honeypot-bans - view and remove IPs banned by the ftp-honeypot fail2ban jail
#
#   sudo ftp-honeypot-bans                 interactive menu
#   sudo ftp-honeypot-bans list            print the banned IPs and exit
#   sudo ftp-honeypot-bans show <IP>       what this IP did (honeypot log)
#   sudo ftp-honeypot-bans unban <IP>...   unban one or more IPs
#   sudo ftp-honeypot-bans unban-all       unban everyone (asks first)
#   sudo ftp-honeypot-bans countries       banned IPs per country
#
# Locations come from the free DB-IP City Lite database (IP Geolocation by
# DB-IP, https://db-ip.com, CC BY 4.0), refreshed monthly by
# ftp-honeypot-geoip-update. They are approximate, city-level at best.

set -uo pipefail

# Column alignment needs a UTF-8 locale (city names like "Linköping").
# Test what bash really does: a configured but missing locale falls back to C.
_u="ö"; (( ${#_u} == 1 )) || export LC_ALL=C.UTF-8; unset _u

JAIL=ftp-honeypot
LOG=/var/log/ftp-honeypot/ftp-honeypot.log
GEOIP_DB=${GEOIP_DB:-/var/lib/ftp-honeypot/dbip-city-lite.mmdb}

if [[ -t 1 ]]; then
    B=$'\033[1m'; DIM=$'\033[2m'; RED=$'\033[31m'; GRN=$'\033[32m'; YEL=$'\033[33m'; CYN=$'\033[36m'; R=$'\033[0m'
else
    B=; DIM=; RED=; GRN=; YEL=; CYN=; R=
fi

die() { echo "${RED}error:${R} $*" >&2; exit 1; }

[[ $EUID -eq 0 ]] || die "run me as root: sudo $0 $*"
command -v fail2ban-client >/dev/null || die "fail2ban-client not found"
fail2ban-client status "$JAIL" >/dev/null 2>&1 \
    || die "fail2ban jail '$JAIL' is not running (systemctl status fail2ban)"

# --- helpers ---------------------------------------------------------------

# "2629800" -> "30d 10h"
human() {
    local s=${1%.*} d h m
    (( s < 0 )) && s=0
    d=$(( s / 86400 )); h=$(( s % 86400 / 3600 )); m=$(( s % 3600 / 60 ))
    if   (( d > 0 )); then echo "${d}d ${h}h"
    elif (( h > 0 )); then echo "${h}h ${m}m"
    else                   echo "${m}m"
    fi
}

# Fills the arrays IPS SINCE UNTIL LEFT, sorted by ban end (fail2ban's order).
load_bans() {
    IPS=(); SINCE=(); UNTIL=(); LEFT=()
    local now line ip start dur end end_s
    now=$(date +%s)
    # each line: "<ip> \t<YYYY-mm-dd HH:MM:SS> + <seconds> = <YYYY-mm-dd HH:MM:SS>"
    while IFS= read -r line; do
        [[ $line =~ ^([^[:space:]]+)[[:space:]]+([0-9-]+\ [0-9:]+)\ \+\ (-?[0-9.]+)\ =\ ([0-9-]+\ [0-9:]+) ]] || continue
        ip=${BASH_REMATCH[1]}; start=${BASH_REMATCH[2]}; dur=${BASH_REMATCH[3]}; end=${BASH_REMATCH[4]}
        IPS+=("$ip"); SINCE+=("${start%:*}")
        if [[ ${dur%.*} -lt 0 ]]; then
            UNTIL+=("permanent"); LEFT+=("-")
        else
            end_s=$(date -d "$end" +%s 2>/dev/null || echo "$now")
            UNTIL+=("${end%:*}"); LEFT+=("$(human $(( end_s - now )))")
        fi
    done < <(fail2ban-client get "$JAIL" banip --with-time 2>/dev/null)
}

# Number of password attempts an IP made, from the honeypot log
attempts() { local n; n=$(grep -Fc "\"event\": \"login\", \"src\": \"$1\"" "$LOG" 2>/dev/null); echo "${n:-0}"; }

# --- geolocation -----------------------------------------------------------

declare -A GEO_CC=() GEO_COUNTRY=() GEO_CITY=() GEO_REGION=()
GEO_OK=0       # 1 = lookups work
GEO_WHY=nodb   # why they don't: nodb | nomodule

# Look up every IP given as arguments in one go and fill the GEO_* arrays.
geo_load() {
    GEO_OK=0; GEO_WHY=nodb
    [[ -r $GEOIP_DB ]] || return 0
    local out rc ip cc country city region
    out=$(printf '%s\n' "$@" | python3 -c '
import sys
try:
    import maxminddb
    db = maxminddb.open_database(sys.argv[1])
except Exception:
    sys.exit(3)
def name(d):
    n = (d or {}).get("names", {})
    v = n.get("en") or next(iter(n.values()), "")
    # never send control characters (terminal escapes) from the database to the terminal
    return "".join(c for c in str(v) if c.isprintable())[:60]
for ip in sys.stdin.read().split():
    try:
        r = db.get(ip) or {}
    except ValueError:
        r = {}
    country = r.get("country") or r.get("registered_country") or {}
    subs = r.get("subdivisions") or [{}]
    cc = "".join(c for c in str(country.get("iso_code", "")) if c.isalnum())[:3]
    print("\t".join([ip, cc, name(country), name(r.get("city")), name(subs[0])]))
' "$GEOIP_DB" 2>/dev/null)
    rc=$?
    if (( rc == 3 )); then GEO_WHY=nomodule; return 0; fi
    (( rc == 0 )) || return 0
    GEO_OK=1
    while IFS=$'\t' read -r ip cc country city region; do
        [[ -n $ip ]] || continue
        GEO_CC[$ip]=$cc; GEO_COUNTRY[$ip]=$country; GEO_CITY[$ip]=$city; GEO_REGION[$ip]=$region
    done <<< "$out"
    return 0
}

# Why there is no location, as a hint
geo_hint() {
    if [[ $GEO_WHY == nomodule ]]; then
        echo "the python3-maxminddb package is missing: sudo apt install python3-maxminddb"
    else
        echo "no GeoIP database yet: sudo ftp-honeypot-geoip-update"
    fi
}

# printf %-Ns counts bytes, so "Linköping" would shift the columns; pad by characters.
pad() { local s=$1 n=$2; printf '%s%*s' "$s" $(( n > ${#s} ? n - ${#s} : 0 )) ""; }

# Short form for the list: "GB London", "FR", "-"
geo_short() {
    local ip=$1 cc=${GEO_CC[$1]:-} city=${GEO_CITY[$1]:-}
    [[ -n $cc ]] || { echo "-"; return; }
    if [[ -n $city ]]; then echo "$cc ${city:0:22}"; else echo "$cc"; fi
}

# Long form for show: "London, England, United Kingdom (GB)"
geo_long() {
    local ip=$1 parts=() x
    for x in "${GEO_CITY[$ip]:-}" "${GEO_REGION[$ip]:-}" "${GEO_COUNTRY[$ip]:-}"; do
        [[ -n $x ]] && parts+=("$x")
    done
    (( ${#parts[@]} )) || { echo "not in the database"; return; }
    local IFS=,
    local out="${parts[*]}"
    out=${out//,/, }
    [[ -n ${GEO_CC[$ip]:-} ]] && out+=" (${GEO_CC[$ip]})"
    echo "$out"
}

geo_footer() {
    if (( GEO_OK )); then
        echo "  ${DIM}locations are approximate · IP geolocation by DB-IP (db-ip.com)${R}"
    else
        echo "  ${DIM}no location data: $(geo_hint)${R}"
    fi
}

# --- views -----------------------------------------------------------------

print_list() {
    load_bans
    echo
    if (( ${#IPS[@]} == 0 )); then
        echo "  ${GRN}No IP is currently banned.${R}"
        return
    fi
    geo_load "${IPS[@]}"
    local w=15 i
    for i in "${IPS[@]}"; do (( ${#i} > w )) && w=${#i}; done   # IP column fits the longest IP
    printf "  ${B}%-4s %-${w}s  %-25s %-16s %-16s %-9s %s${R}\n" "#" "IP" "location" "banned since" "until" "left" "logins"
    for i in "${!IPS[@]}"; do
        printf "  %-4s %-${w}s  %s %-16s %-16s %-9s %s\n" \
            "$((i+1))" "${IPS[i]}" "$(pad "$(geo_short "${IPS[i]}")" 25)" "${SINCE[i]}" "${UNTIL[i]}" "${LEFT[i]}" "$(attempts "${IPS[i]}")"
    done
    echo "  ${DIM}${#IPS[@]} banned · times are server local time${R}"
    geo_footer
}

# Banned IPs per country, most first
print_countries() {
    load_bans
    echo
    (( ${#IPS[@]} )) || { echo "  ${GRN}No IP is currently banned.${R}"; return; }
    geo_load "${IPS[@]}"
    (( GEO_OK )) || { geo_footer; return; }
    local ip key
    declare -A count=()
    for ip in "${IPS[@]}"; do
        key="${GEO_CC[$ip]:-??}"$'\t'"${GEO_COUNTRY[$ip]:-unknown}"
        count[$key]=$(( ${count[$key]:-0} + 1 ))
    done
    printf "  ${B}%-6s %-4s %s${R}\n" "bans" "cc" "country"
    for key in "${!count[@]}"; do printf '%s\t%s\n' "${count[$key]}" "$key"; done \
        | sort -t$'\t' -k1,1nr -k3 \
        | while IFS=$'\t' read -r n cc name; do printf "  %-6s %-4s %s\n" "$n" "$cc" "$name"; done
    echo "  ${DIM}${#IPS[@]} banned IPs in ${#count[@]} countries${R}"
    geo_footer
}

show_ip() {
    local ip=$1
    echo
    echo "  ${B}$ip${R}"
    geo_load "$ip"
    if (( GEO_OK )); then
        echo "  location:    $(geo_long "$ip")   ${DIM}(approximate · DB-IP)${R}"
    else
        echo "  location:    ${DIM}unknown ($(geo_hint))${R}"
    fi
    if [[ ! -r $LOG ]]; then echo "  (log $LOG not readable)"; return; fi
    local first last n
    n=$(grep -Fc "\"src\": \"$ip\"" "$LOG" 2>/dev/null || true)
    if [[ ${n:-0} -eq 0 ]]; then
        echo "  ${DIM}nothing in the current log (it may have been rotated)${R}"
        return
    fi
    first=$(grep -F -m1 "\"src\": \"$ip\"" "$LOG" | sed -E 's/^\{"ts": "([^"]+)".*/\1/')
    last=$(grep -F "\"src\": \"$ip\"" "$LOG" | tail -1 | sed -E 's/^\{"ts": "([^"]+)".*/\1/')
    echo "  connections: $(grep -Fc "\"event\": \"connect\", \"src\": \"$ip\"" "$LOG")   first seen: $first   last seen: $last (UTC)"
    if [[ $(attempts "$ip") -eq 0 ]]; then
        echo "  ${DIM}no password tried${R}"
    else
        echo "  ${CYN}last credentials tried:${R}"
    fi
    grep -F "\"event\": \"login\", \"src\": \"$ip\"" "$LOG" | tail -10 | python3 -c '
import sys, json
for l in sys.stdin:
    try: e = json.loads(l)
    except ValueError: continue
    print("    %s  user=%r  pass=%r" % (e.get("ts"), e.get("user"), e.get("password")))
' 2>/dev/null || true
    local cmds
    cmds=$(grep -F "\"event\": \"cmd\", \"src\": \"$ip\"" "$LOG" | tail -5)
    if [[ -n $cmds ]]; then
        echo "  ${CYN}last other commands:${R}"
        echo "$cmds" | python3 -c '
import sys, json
for l in sys.stdin:
    try: e = json.loads(l)
    except ValueError: continue
    print("    %s  %r" % (e.get("ts"), e.get("cmd")))
' 2>/dev/null || true
    fi
}

is_banned() { local x; for x in "${IPS[@]}"; do [[ $x == "$1" ]] && return 0; done; return 1; }

unban() {
    local ip
    for ip in "$@"; do
        if fail2ban-client set "$JAIL" unbanip "$ip" >/dev/null 2>&1; then
            echo "  ${GRN}unbanned${R} $ip"
        else
            echo "  ${YEL}not banned${R} $ip"
        fi
    done
}

unban_all() {
    load_bans
    (( ${#IPS[@]} > 0 )) || { echo "  nothing to unban"; return; }
    local ans
    read -r -p "  Unban all ${#IPS[@]} IPs? [y/N] " ans
    [[ $ans =~ ^[yY]$ ]] || { echo "  cancelled"; return; }
    unban "${IPS[@]}"
}

# "3", "1 4", "1,2", "2-5", or IPs -> list of IPs (uses the last loaded list)
resolve() {
    local -; set -f          # no glob expansion: "u *" must not turn into file names
    local tok a b i out=()
    for tok in ${*//,/ }; do
        if [[ $tok =~ ^([0-9]+)-([0-9]+)$ ]]; then
            for (( i=BASH_REMATCH[1]; i<=BASH_REMATCH[2]; i++ )); do
                (( i>=1 && i<=${#IPS[@]} )) && out+=("${IPS[i-1]}")
            done
        elif [[ $tok =~ ^[0-9]+$ ]] && (( tok >= 1 && tok <= ${#IPS[@]} )); then
            out+=("${IPS[tok-1]}")
        elif [[ $tok == *.* || $tok == *:* ]]; then
            out+=("$tok")
        else
            echo "  ${YEL}ignored:${R} $tok" >&2
        fi
    done
    (( ${#out[@]} )) && printf '%s\n' "${out[@]}"
    return 0
}

menu() {
    local choice arg ips
    print_list
    while true; do
        echo
        echo "  ${B}[l]${R}ist  ${B}[s]${R}how <#|IP>  ${B}[u]${R}nban <#|IP> (e.g. 1 3 5-7)  ${B}[a]${R}ll unban  ${B}[c]${R}ountries  ${B}[q]${R}uit"
        read -r -p "  > " choice arg || { echo; return; }
        case "$choice" in
            l|L|"")  print_list ;;
            s|S)     [[ -n $arg ]] || read -r -p "  which # or IP? " arg
                     mapfile -t ips < <(resolve "$arg")
                     for ip in "${ips[@]}"; do show_ip "$ip"; done ;;
            u|U)     [[ -n $arg ]] || read -r -p "  which # or IP? " arg
                     mapfile -t ips < <(resolve "$arg")
                     (( ${#ips[@]} )) && unban "${ips[@]}" && print_list ;;
            a|A)     unban_all; print_list ;;
            c|C)     print_countries ;;
            q|Q|quit|exit) return ;;
            *)       echo "  ${YEL}unknown choice${R}" ;;
        esac
    done
}

# --- main ------------------------------------------------------------------

case "${1:-}" in
    "")          menu ;;
    list)        print_list ;;
    show)        shift; (( $# )) || die "usage: $0 show <IP>"; for ip in "$@"; do show_ip "$ip"; done ;;
    unban)       shift; (( $# )) || die "usage: $0 unban <IP>..."; unban "$@" ;;
    unban-all)   unban_all ;;
    countries)   print_countries ;;
    -h|--help)   sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//' ;;
    *)           die "unknown command '$1' (see --help)" ;;
esac
